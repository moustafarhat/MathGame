<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MathGame.ViewModels"
             x:Class="MathGame.Views.PlayView"
             x:DataType="vm:PlayViewModel"
             Focusable="True">

    <DockPanel Margin="24,20">
        <!-- Header: back, stage title, progress -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
            <Button Content="← Map" Command="{Binding QuitCommand}" ToolTip.Tip="Back to the map (Esc)"/>
            <TextBlock Grid.Column="1" Text="{Binding StageTitle}" FontSize="18" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock Text="{Binding ProgressText}" Classes="muted" HorizontalAlignment="Right"/>
                <TextBlock Text="{Binding StreakText}" Classes="stars" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- Hint -->
        <TextBlock DockPanel.Dock="Bottom" Classes="muted" HorizontalAlignment="Center" FontSize="12"
                   Text="{Binding KeyHint}"/>

        <StackPanel VerticalAlignment="Center" Spacing="20">
            <TextBlock Text="{Binding Prompt}" FontSize="{Binding PromptFontSize}" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>

            <!-- Multiple choice -->
            <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding IsChoice}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ChoiceItem">
                        <Button Command="{Binding SelectCommand}"
                                Classes.correct="{Binding IsMarkedCorrect}"
                                Classes.wrong="{Binding IsMarkedWrong}"
                                MinWidth="140" MinHeight="64" Margin="6" Padding="16,8"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="{Binding Shortcut}" FontSize="11" Opacity="0.6"
                                           VerticalAlignment="Top" Margin="0,0,10,0"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="22"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Number input -->
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding IsNumber}">
                <TextBox Name="AnswerBox" Text="{Binding AnswerText}" Width="160" FontSize="24"
                         HorizontalContentAlignment="Center" PlaceholderText="Answer"
                         IsEnabled="{Binding !IsAnswered}"/>
                <Button Content="Check" Command="{Binding SubmitNumberCommand}" FontSize="18" Padding="20,8"/>
            </StackPanel>

            <!-- Feedback; the Panel keeps its space reserved so the question doesn't jump when it appears. -->
            <Panel MinHeight="130">
                <StackPanel Spacing="4" HorizontalAlignment="Center" IsVisible="{Binding IsAnswered}">
                    <TextBlock Text="{Binding Feedback}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource CorrectBrush}" IsVisible="{Binding WasCorrect}"/>
                    <TextBlock Text="{Binding Feedback}" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center"
                               Foreground="{StaticResource WrongBrush}" IsVisible="{Binding !WasCorrect}"/>
                    <TextBlock Text="{Binding Explanation}" FontSize="16" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <Button Content="Continue" Command="{Binding ContinueCommand}" IsVisible="{Binding ShowContinue}"
                            HorizontalAlignment="Center" Margin="0,8,0,0" Padding="24,8" Classes="accent"/>
                </StackPanel>
            </Panel>
        </StackPanel>
    </DockPanel>

</UserControl>
